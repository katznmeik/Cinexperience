# Local configuration
local.properties

# Locally saved yorck.de pages for RealProgramPageTest (CINEX_PROGRAM_PAGE):
# Yorck's content is copyrighted and never committed. Keep them in yorck-pages/
# or name them *.yorck.html.
yorck-pages/
*.yorck.html
*yorck.de*.html

# Real ticket PDFs for RealTicketTest (CINEX_TICKET_PDF): they hold a booking
# number, a name and a QR code and are never committed (spec §11.2). Keep them in
# tickets/ at the repository root (anchored, so feature/tickets/ isn't ignored) or
# name them *.ticket.pdf.
/tickets/
*.ticket.pdf

# Signing material — never commit (spec §14.4)
*.jks
*.keystore
*.p12
keystore.properties

# IDE / OS files
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
