<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon: the light mark on the app's near-black background. The
     monochrome layer is used for Android 13+ themed icons. minSdk is 34, so every
     device supports adaptive icons: no density PNG fallbacks are needed. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/cinex_background" />
    <foreground android:drawable="@drawable/ic_launcher_mark" />
    <monochrome android:drawable="@drawable/ic_launcher_mark" />
</adaptive-icon>
