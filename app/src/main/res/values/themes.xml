<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark only (spec §7). Compose draws everything; this only sets the window
         background shown before the first frame, and dark system bars. -->
    <style name="Theme.Cinexperience" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/cinex_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
