<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark only (spec §7). Compose draws everything; this only sets the window
         background shown before the first frame, and dark system bars. -->
    <style name="Theme.Cinexperience" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/cinex_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- Launch theme of MainActivity: the splash screen (the icon mark on the app
         background, so a cold start never flashes white). installSplashScreen()
         switches to Theme.Cinexperience before the first frame. The system bars
         match it: transparent with light icons, as enableEdgeToEdge() sets them. -->
    <style name="Theme.Cinexperience.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cinex_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_mark</item>
        <item name="postSplashScreenTheme">@style/Theme.Cinexperience</item>
        <item name="android:windowBackground">@color/cinex_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
